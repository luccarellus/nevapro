# ORDEM DE CARREGAMENTO: .env.local tem PRIORIDADE sobre .env (padrão dotenvx do app).
# Se existir .env.local, os valores dele vencem. Mantenha apenas um dos dois com as
# credenciais reais de Postgres/Redis para evitar validar/testar credenciais erradas.

# APP_URL: URL pública do app. Usada em links de e-mail (reset de senha) e referências próprias.
# Na VPS: https://seu-dominio.com
APP_URL="https://seu-dominio.com"
APP_KEY=

# FRONTEND_URL: origem(is) permitida(s) no CORS, separadas por vírgula. Deve ser o domínio público.
FRONTEND_URL="https://seu-dominio.com"

# PostgreSQL database for the app (direct connection to your VPS PostgreSQL).
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/nevapro"

# Senha do container Postgres do docker-compose (obrigatória para `docker compose up`).
# Mantenha o mesmo valor usado em DATABASE_URL acima.
POSTGRES_PASSWORD="YOUR_PASSWORD"

# Secret obrigatório para assinatura HMAC de sessões de alunos e admins (mínimo 32 caracteres)
JWT_SECRET="SEU_JWT_SECRET_SUPER_SEGURO_COM_32_CARACTERES_MINIMO"

# SSL/TLS do PostgreSQL:
#   require / verify-ca / verify-full  -> exigem TLS no banco (recomendado em produção)
#   prefer                             -> usa TLS se o banco oferecer, senão conecta sem (padrão)
#   disable                            -> nunca usa TLS
DB_SSLMODE="prefer"

# Additional settings
# Comma-separated allowlist for the image proxy hosts, e.g. s3.amazonaws.com
ALLOWED_IMAGE_HOSTS="s3.amazonaws.com"

# Segredo de autenticação das tarefas de Cron (/api/cron/*)
CRON_SECRET="SUA_CHAVE_SECRETA_CRON_AQUI"

# Segredo de autenticação da integração do EventEase (/api/webhooks/eventease)
EVENTEASE_WEBHOOK_SECRET="SUA_CHAVE_SECRETA_EVENTEASE_AQUI"


# Redis
# O Docker Compose configura Redis para cache, sessoes, filas e rate limit.
# O servico Redis e privado na rede Docker e persiste dados no volume redis_data.
# Para EasyPanel/outro runtime, configure CACHE_STORE=redis, SESSION_DRIVER=redis,
# QUEUE_CONNECTION=redis e REDIS_CLIENT=predis no servico Laravel.
# Para menor latência, mantenha aplicação e Redis na mesma rede privada Docker/VPS.
# Evite expor Redis à internet: uma rota remota pode adicionar dezenas de ms por operação.
# REDIS_REMOTE_MODE="false"  # opcional; detecção automática usa endereço privado como local
# REDIS_URL pode conter credenciais; REDIS_USERNAME/REDIS_PASSWORD também são aceitos
# como fallback quando a URL não inclui esses campos.
# Ex. VPS (compose): redis://default:[SENHA]@redis:6379
# Ex. dev local: redis://localhost:6379
# Sem Redis no runtime Node legado, o app usa fallback em memória.
# REDIS_URL="redis://localhost:6379"
# REDIS_HOST="localhost"
# REDIS_PORT=6379
# REDIS_PASSWORD=""
# REDIS_USERNAME="default"

# Google reCAPTCHA v3 — proteger formulários contra bots
# RECAPTCHA_SECRET_KEY: usada no servidor para verificar o token (NÃO expor ao frontend)
RECAPTCHA_SECRET_KEY=""

# VITE_RECAPTCHA_SITE_KEY: exposta ao frontend via import.meta.env para carregar o widget
VITE_RECAPTCHA_SITE_KEY=""

# Resend — envio de e‑mails transacionais (redefinição de senha etc.)
# Crie sua API key em https://resend.com/api-keys
RESEND_API_KEY="re_SUA_API_KEY_AQUI"
RESEND_FROM_EMAIL="naoresponda@seudominio.com"
RESEND_SENDER_NAME="Neva PRO"
LOGO_URL="https://raw.githubusercontent.com/luccarellus/nevapro/main/public/favicon.png"


# Modo de Manutenção (true | false)
VITE_MAINTENANCE_MODE="false"
# EnemHub API (2a fonte de questoes ENEM)
ENEMHUB_API_KEY=""
