# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL pública do app. Usada em links de e-mail (reset de senha) e referências próprias.
# Na VPS: https://seu-dominio.com
APP_URL="https://seu-dominio.com"

# FRONTEND_URL: origem(is) permitida(s) no CORS, separadas por vírgula. Deve ser o domínio público.
FRONTEND_URL="https://seu-dominio.com"

# PostgreSQL database for the app.
# For Supabase, use the database connection string from the project settings.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# Secret obrigatório para assinatura HMAC de sessões de alunos (mínimo 32 caracteres)
JWT_SECRET="SEU_JWT_SECRET_SUPER_SEGURO_COM_32_CARACTERES_MINIMO"

# SSL/TLS do PostgreSQL. Para Supabase ou bancos com certificado auto-assinado, defina DB_SSL_REJECT_UNAUTHORIZED="false".
DISABLE_DB_SSL="false"
DB_SSL_REJECT_UNAUTHORIZED="false"
# DB_CA_CERT="/caminho/para/ca-certificate.crt"

# Optional: enable these if you want to use Supabase Auth/Storage later.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"
SUPABASE_ANON_KEY="YOUR_ANON_KEY"


# VITE prefix vars — expostas ao frontend via import.meta.env (necessárias para reset de senha)
# ATENÇÃO: .env não expande variáveis automaticamente. Defina valores explícitos:
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_ANON_KEY="sua-anon-key-aqui"

# Additional settings
# Comma-separated allowlist for the image proxy hosts, e.g. s3.amazonaws.com
ALLOWED_IMAGE_HOSTS="s3.amazonaws.com,nevapro.s3.us-east-005.backblazeb2.com"

# Backblaze B2 Configs
B2_ENDPOINT="https://s3.us-east-005.backblazeb2.com"
B2_KEY_ID="YOUR_B2_KEY_ID"
B2_APPLICATION_KEY="YOUR_B2_APPLICATION_KEY"
B2_BUCKET_NAME="nevapro"
B2_REGION="us-east-005"
# Prefixo virtual criado no bucket para logs técnicos e registros de consentimento.
B2_LOG_PREFIX="logs"
# Configurações de backup do banco de dados no B2
B2_BACKUP_PREFIX="backups"
B2_BACKUP_RETENTION_DAYS="30"
# Se utilizar proxy HTTPS ou S3 com certificado auto-assinado:
# B2_SSL_REJECT_UNAUTHORIZED="false"

# Segredo de autenticação das tarefas de Cron (/api/cron/*)
CRON_SECRET="SUA_CHAVE_SECRETA_CRON_AQUI"

# Segredo de autenticação da integração do EventEase (/api/webhooks/eventease)
EVENTEASE_WEBHOOK_SECRET="SUA_CHAVE_SECRETA_EVENTEASE_AQUI"


# Redis
# Na VPS: o docker-compose sobe um container Redis e injeta REDIS_URL automaticamente
# (não precisa preencher aqui). Fora do compose (dev local), descomente para usar Redis:
# REDIS_URL="redis://localhost:6379"
# Sem Redis configurado, o app usa fallback em memória (cache e rate-limit por instância).

# Google reCAPTCHA v3 — proteger formulários contra bots
# RECAPTCHA_SECRET_KEY: usada no servidor para verificar o token (NÃO expor ao frontend)
RECAPTCHA_SECRET_KEY=""

# VITE_RECAPTCHA_SITE_KEY: exposta ao frontend via import.meta.env para carregar o widget
VITE_RECAPTCHA_SITE_KEY=""

# Resend — envio de e‑mails transacionais (redefinição de senha etc.)
# Crie sua API key em https://resend.com/api-keys
RESEND_API_KEY="re_SUA_API_KEY_AQUI"
RESEND_FROM_EMAIL="naoresponda@seudominio.com"
RESEND_SENDER_NAME="Olhar Jovem"
LOGO_URL="https://raw.githubusercontent.com/luccarellus/nevapro/main/public/logo.png"


# Sentry (use projetos separados para frontend e backend)
VITE_SENTRY_DSN=""
SENTRY_DSN=""

# Modo de Manutenção (true | false)
VITE_MAINTENANCE_MODE="false"

