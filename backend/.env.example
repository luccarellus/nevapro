APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# false por padrão: APP_DEBUG=true expõe stack traces e variáveis de ambiente
# em qualquer erro. Ligue apenas em desenvolvimento.
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookies só são enviados em HTTPS (true em produção; false apenas em dev HTTP local)
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ===== Segurança =====
# Segredo compartilhado: assina os tokens anti-CSRF (double-submit HMAC) e as
# URLs de /api/storage/object. Sem ele (ou com menos de 16 caracteres) a
# assinatura de storage falha fechado (403/503) e o boot registra erro crítico.
# Gere com: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=
# Chave secreta do reCAPTCHA v3. Quando vazia, as rotas protegidas
# ficam sem verificação (documentado): configure para ativar a proteção.
RECAPTCHA_SECRET_KEY=
# Segredo compartilhado do webhook EventEase (obrigatório em produção)
EVENTEASE_WEBHOOK_SECRET=
# Segredo das rotas cron (obrigatório em produção)
CRON_SECRET=

# ===== E-mail transacional (Resend) =====
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_SENDER_NAME=

# ===== EnemHub (2ª fonte de questões) =====
ENEMHUB_API_KEY=

# ===== Proxy de imagens (allowlist de hosts, separados por vírgula) =====
ALLOWED_IMAGE_HOSTS=

# ===== Backblaze B2 (avatares e materiais; sem isto o upload responde 503) =====
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_ENDPOINT=
B2_REGION=us-east-005
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
