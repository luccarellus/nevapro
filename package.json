{
  "name": "nevapro",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions",
    "not dead"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "dev:frontend": "vite",
    "build:api": "esbuild server/vercel.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=api/index.js",
    "build:frontend": "vite build",
    "build": "npm run build:frontend && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "test:backblaze-logs": "tsx server/scripts/testBackblazeLogs.ts",
    "test:backblaze-backup": "tsx server/scripts/testBackblazeBackup.ts",
    "backup:db": "tsx server/scripts/runBackup.ts",
    "db:schema": "node -e \"require('dotenv').config();const{Pool}=require('pg');const fs=require('fs');const pool=new Pool({connectionString:process.env.DATABASE_URL});pool.query(fs.readFileSync('scripts/schema.sql','utf-8')).then(()=>console.log('Schema OK')).catch(e=>{console.error(e.message);process.exit(1)}).finally(()=>pool.end())\"",
    "promote:admin": "tsx server/scripts/promoteSuperAdmin.ts",
    "create:admin": "tsx server/scripts/createAdmin.ts",
    "verify:connections": "tsx server/scripts/verifyConnections.ts",
    "sisu:ingest": "tsx server/scripts/ingestSisuCutoffs.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1083.0",
    "@google/genai": "^1.29.0",
    "@sentry/node": "^10.66.0",
    "@sentry/react": "^10.66.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.2.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.1.1",
    "pg": "^8.11.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.17.2",
    "sanitize-html": "^2.17.7",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.11.0",
    "@types/react-dom": "^19.2.4",
    "@types/sanitize-html": "^2.16.2",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.10"
  }
}
