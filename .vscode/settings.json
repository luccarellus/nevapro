{
  "css.validate": false,
  "scss.validate": false,
  "less.validate": false,
  "html.validate.styles": false,
  "css-compatibility.enable": false,
  "docker.scout.enable": false,
  "docker.languageserver.diagnostics.deprecatedMaintainer": "ignore",
