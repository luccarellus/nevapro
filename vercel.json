{
  "version": 2,
  "buildCommand": "vite build && npx esbuild api/index.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=api/index.js",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api|assets|.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
